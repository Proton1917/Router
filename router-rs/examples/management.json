{
  "listen": "127.0.0.1:8081",
  "assets_directory": "../../.local/share/router/web",
  "token_file": "control-token",
  "credential_directory": "credentials",
  "launcher_directory": "../../.local/bin",
  "shell_file": "commands.zsh",
  "log_directory": "logs",
  "browser": {"program": "open", "args": ["-a", "Safari", "{{ url }}"]},
  "command_header": "x-router-command",
  "max_request_bytes": 16777216,
  "backend_protocols": {"messages": ["messages"], "responses": ["responses"]},
  "templates": {
    "messages-client": {
      "label": "Claude Code API",
      "supports_mods": true,
      "description": "通过网关调用兼容 Messages 的后端。",
      "program": "claude",
      "args": [],
      "model_flags": ["--model"],
      "header_env": "ANTHROPIC_CUSTOM_HEADERS",
      "request_path": "/v1/messages",
      "route_before": "messages",
      "env": {"ANTHROPIC_BASE_URL": "{{ gateway_url }}", "ANTHROPIC_AUTH_TOKEN": "local-router", "ANTHROPIC_API_KEY": ""}
    },
    "responses-client": {
      "label": "Codex API",
      "options": {
        "service-tier": {
          "label": "启动服务等级",
          "default": "standard",
          "choices": {
            "standard": {"label": "标准", "args": ["-c", "service_tier=\"default\""]},
            "fast": {"label": "Fast · 快速", "args": ["-c", "service_tier=\"fast\""]}
          }
        }
      },
      "description": "通过网关调用原生 Responses 后端。",
      "program": "codex",
      "args": ["-c", "model_provider=\"router\"", "-c", "model_providers.router.name=\"router\"", "-c", "model_providers.router.base_url=\"{{ gateway_url }}/v1\"", "-c", "model_providers.router.wire_api=\"responses\"", "-c", "model_providers.router.requires_openai_auth=false", "-c", "model_providers.router.supports_websockets=false", "-c", "model_providers.router.http_headers={\"{{ command_header }}\"=\"{{ command_name }}\"}"],
      "model_flags": ["--model", "-m"],
      "request_path": "/v1/responses",
      "route_before": "responses",
      "unset_env": ["OPENAI_API_KEY", "OPENAI_BASE_URL"]
    },
    "account-client": {
      "label": "Codex 登录",
      "description": "使用客户端的 ChatGPT 登录凭据和原生模型。",
      "program": "codex",
      "args": ["-c", "model_provider=\"openai\"", "-c", "forced_login_method=\"chatgpt\""],
      "model_flags": ["--model", "-m"],
      "unset_env": ["OPENAI_API_KEY", "OPENAI_BASE_URL"]
    }
  },
  "commands": {},
  "mods": {
    "adapter": {"program":"python3", "args":["{{ config_directory }}/application/scripts/claude-mods.py"]},
    "timeout_ms": 45000,
    "settings": {"program":"claude", "minimum_version":"2.1.287", "launch_directory":"client-state/mods"},
    "catalog": {
      "diff": {"label":"Diff 面板", "plugin_id":"cc-plugin-diff@builtin", "description":"显示文件改动和差异面板。", "builtin":true},
      "agents-md": {"label":"AGENTS.md 指令", "plugin_id":"cc-plugin-agents-md@builtin", "description":"将项目 AGENTS.md 加载为客户端指令。", "builtin":true},
      "you-should-know": {"label":"You should know", "plugin_id":"cc-plugin-you-should-know@builtin", "description":"在任务执行期间提供辅助提醒。", "builtin":true, "availability":"需要官方账号会话、遥测及组织可用资格。"}
    },
    "profiles": {"default":{"label":"默认组合", "plugins":{}}}
  }
}
