{
  "listen": "127.0.0.1:8081",
  "assets_directory": "../../.local/share/router/web",
  "token_file": "control-token",
  "credential_directory": "credentials",
  "launcher_directory": "../../.local/bin",
  "shell_file": "commands.zsh",
  "log_directory": "logs",
  "browser": {"program": "open", "args": ["-a", "Safari", "{{ url }}"]},
  "command_header": "x-router-command",
  "max_request_bytes": 16777216,
  "context_discovery": {
    "adapter": {"program":"python3", "args":["{{ config_directory }}/application/scripts/model-context.py"]},
    "settings": {"cache_directory":"client-state/model-context", "ttl_seconds":21600, "timeout_seconds":15, "sources":{}}
  },
  "backend_protocols": {"messages": ["messages"], "responses": ["responses"]},
  "templates": {
    "spt": {
      "label": "SPT · 语音转写与 OCR",
      "description": "通过 Router 后台处理媒体，在原文件旁保存 Markdown。",
      "program": "python3",
      "args": ["{{ config.management.assets_directory }}/../scripts/spt-launch.py"],
      "deferred": true,
      "env": {"ROUTER_SPT": "1"},
      "model_flags": []
    },
    "messages-client": {
      "label": "Claude Code API",
      "supports_mods": true,
      "description": "通过网关调用兼容 Messages 的后端。",
      "program": "claude",
      "model_adapter": {"program":"python3", "args":["{{ config_directory }}/application/scripts/claude-model-catalog.py"]},
      "context_window_range": {"min":100000,"max":1000000},
      "options": {
        "router-speed": {
          "label": "Fast 控制方式（重新启动命令后生效）",
          "default": "client",
          "choices": {
            "client": {"label": "客户端 /fast · 会话内切换", "args": []},
            "standard": {"label": "标准 · 使用各模型的标准目标", "args": []},
            "fast": {"label": "Fast · 使用各模型的快速目标", "args": []}
          }
        }
      },
      "args": ["--settings", "{\"enabledPlugins\":{\"cc-plugin-agents-md@builtin\":true},\"pluginConfigs\":{\"cc-plugin-agents-md@builtin\":{\"options\":{\"instructionFiles\":\"claude-md-and-agents-md\"}}}}"],
      "model_flags": ["--model"],
      "header_env": "ANTHROPIC_CUSTOM_HEADERS",
      "request_path": "/v1/messages",
      "route_before": "messages",
      "env": {"ANTHROPIC_BASE_URL": "{{ gateway_url }}", "ANTHROPIC_AUTH_TOKEN": "local-router", "ANTHROPIC_API_KEY": "", "CLAUDE_CODE_MAX_CONTEXT_TOKENS":"200000"}
    },
    "responses-client": {
      "label": "Codex · API／独立账号",
      "deferred": true,
      "env": {
        "ROUTER_CODEX_USE_CATALOG": "0",
        "ROUTER_CODEX_SERVICE_TIERS": "{\"standard\":\"default\",\"fast\":\"fast\"}",
        "ROUTER_CODEX_ACCOUNT_HOME": "{{ config.management.credential_directory }}/codex/{{ command_name }}",
        "ROUTER_CODEX_ACCOUNT_ARGS": "[\"--no-daemon\",\"-c\",\"model_provider=\\\"openai\\\"\",\"-c\",\"forced_login_method=\\\"chatgpt\\\"\",\"-c\",\"cli_auth_credentials_store=\\\"file\\\"\"]"
      },
      "options": {
        "auth-mode": {
          "label": "默认启动模式",
          "default": "api",
          "choices": {
            "api": {"label": "API · Router 模型与后端", "args": []},
            "account": {"label": "账号登录 · 独立 ChatGPT 账号", "args": []}
          }
        },
        "service-tier": {
          "label": "启动服务等级",
          "default": "standard",
          "choices": {
            "standard": {"label": "标准", "args": ["--router-service-tier", "standard"]},
            "fast": {"label": "Fast · 快速", "args": ["--router-service-tier", "fast"]}
          }
        }
      },
      "description": "选择 Router API 或独立 ChatGPT 账号登录，分别保留模型列表与登录凭据。",
      "program": "python3",
      "args": ["{{ config.management.assets_directory }}/../scripts/codex-launch.py", "-", "client-state/codex-catalogs", "codex", "-c", "model_provider=\"router\"", "-c", "model_providers.router.name=\"router\"", "-c", "model_providers.router.base_url=\"{{ gateway_url }}/v1\"", "-c", "model_providers.router.wire_api=\"responses\"", "-c", "model_providers.router.requires_openai_auth=false", "-c", "model_providers.router.supports_websockets=false", "-c", "model_providers.router.http_headers={\"{{ command_header }}\"=\"{{ command_name }}\"}", "--"],
      "model_flags": [],
      "request_path": "/v1/responses",
      "route_before": "responses",
      "unset_env": ["OPENAI_API_KEY", "OPENAI_BASE_URL"]
    },
    "account-client": {
      "label": "Codex 登录",
      "description": "使用客户端的 ChatGPT 登录凭据和原生模型。",
      "program": "codex",
      "args": ["-c", "model_provider=\"openai\"", "-c", "forced_login_method=\"chatgpt\""],
      "model_flags": ["--model", "-m"],
      "unset_env": ["OPENAI_API_KEY", "OPENAI_BASE_URL"]
    }
  },
  "commands": {"spt":{"template":"spt","label":"语音转写与图片识别","enabled":true}},
  "mods": {
    "adapter": {"program":"python3", "args":["{{ config_directory }}/application/scripts/claude-mods.py"]},
    "timeout_ms": 45000,
    "settings": {"program":"claude", "minimum_version":"2.1.287", "launch_directory":"client-state/mods"},
    "catalog": {
      "diff": {"label":"Diff 面板", "plugin_id":"cc-plugin-diff@builtin", "description":"显示文件改动和差异面板。", "builtin":true},
      "agents-md": {"label":"AGENTS.md 指令", "plugin_id":"cc-plugin-agents-md@builtin", "description":"将项目 AGENTS.md 加载为客户端指令。", "builtin":true},
      "you-should-know": {"label":"You should know", "plugin_id":"cc-plugin-you-should-know@builtin", "description":"在任务执行期间提供辅助提醒。", "builtin":true, "availability":"需要官方账号会话、遥测及组织可用资格。"}
    },
    "profiles": {"default":{"label":"默认组合", "plugins":{}}}
  }
}
